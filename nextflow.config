// nextflow.config

// =======================
//  Núcleos disponibles
// =======================
def nCores = Runtime.runtime.availableProcessors()
def reserve = (nCores > 4 ? 2 : 1)   // deja 1–2 cores libres
def usable  = Math.max(1, nCores - reserve)

// Elegimos 3 jobs GNU parallel por organismo (3 pfam_scan -cpu 1 en paralelo)
def defaultPfamCpus = 1
// nº de organismos simultáneos ≈ usable / defaultPfamCpus
def defaultPfamMaxForks = Math.max(1, (int)(usable / defaultPfamCpus))
params.iqtree_cpus = 9   // o 8 si quieres ir más conservador

params {
  // Datos de entrada
  input_dir   = "${projectDir}/assets/toys"
  outdir      = "results"
  organisms   = [
    'Ecoli',
    'Bsubtilis',
    'Mjannaschii',
    'Scerevisiae',
    'Synechocystis',
    'Planctopirus',
    'Lokiarchaeota'
  ]

  // Arquitecturas
  dataset_version   = 'toy'
  overlap_threshold = 30

  // ---- PFAM_SCAN estilo hpc (chunking + parallel) ----
  // puedes sobreescribirlos en la línea de comando si quieres probar otras combinaciones:
  //   --pfam_cpus 2 --pfam_maxForks 4
  pfam_cpus     = defaultPfamCpus
  pfam_maxForks = defaultPfamMaxForks
  pfam_label    = "hpcchunk_${pfam_cpus}x${pfam_maxForks}"
}

// =======================
//  Ejecutor / contenedor
// =======================
process {
  executor  = 'local'
  container = 'pfam_scan_arm'
}

// Montar Pfam local en el contenedor en /db
docker.enabled    = true
docker.runOptions = '-v /Users/rubensiok/PfamScan:/db:ro'

// =======================
//  Métricas / benchmarking
// =======================
trace {
  enabled = true
  file    = "${params.outdir}/trace_${params.pfam_label}.txt"
}
timeline {
  enabled = true
  file    = "${params.outdir}/timeline_${params.pfam_label}.html"
}
report {
  enabled = true
  file    = "${params.outdir}/report_${params.pfam_label}.html"
}